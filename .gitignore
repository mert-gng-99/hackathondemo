# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv*/
venv*/
env/

# Secrets — never commit
.env
.env.local
.env.*.local

# Data — only keep folder structure, never raw payloads
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# MLflow / experiment tracking
mlruns/
mlartifacts/

# Claude Code / agent tooling
.sixth/
.worktrees/

# IDE
.idea/
.vscode/
.DS_Store
